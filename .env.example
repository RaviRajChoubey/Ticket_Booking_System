# ============================================================
# TicketHub — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ── PostgreSQL Database (Supabase) ──────────────────────────
# Get from: supabase.com → Project Settings → Database → URI
# Use the "Transaction mode" URI (port 6543) for DATABASE_URL
# Use the "Session mode" URI (port 5432) for DIRECT_URL (migrations)
DATABASE_URL="postgresql://postgres:P@l@kkumari2007@rihcejhtbtcmzmzkcgyj.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:P@l@kkumari2007@db.rihcejhtbtcmzmzkcgyj.supabase.co:5432/postgres"

# ── NextAuth.js ─────────────────────────────────────────────
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
# Set to your production URL on Vercel, or http://localhost:3000 locally
NEXTAUTH_URL="http://localhost:3000"

# ── Upstash Redis (Seat Hold TTL) ───────────────────────────
# Get from: console.upstash.com → Your Database → REST API
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# ── Resend (Email + QR delivery) ───────────────────────────
# Get from: resend.com → API Keys → Create API Key
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Set to your verified sender domain/email in Resend
RESEND_FROM_EMAIL="tickets@yourdomain.com"

# ── App Config ──────────────────────────────────────────────
# Your deployed URL (used for waitlist offer links in emails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Cron Job Security ────────────────────────────────────────
# A random secret to protect /api/cron/* endpoints from public access
# Vercel cron jobs will include this as: Authorization: Bearer <secret>
CRON_SECRET="your-random-cron-secret-here"
